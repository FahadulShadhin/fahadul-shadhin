---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import EmailIcon from "../icons/email.svg";
import ArrowUpRightIcon from "../icons/arrow-up-right.svg";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<SiteLayout title="Blog — Fahadul Islam Shadhin" description="Writing and notes on software engineering, commerce, dependable workflows, and tools.">
  <section class="page-intro">
    <p class="eyebrow">Writing & notes</p>
    <h1>Blog<span>.</span></h1>
    <p class="page-description">Things I’m learning and thinking through—from building dependable software to the tiny tools that make work better.</p>
  </section>

  {posts.length > 0 ? (
    <section class="post-list" aria-label="Blog posts">
      {posts.map((post) => (
        <article class="post">
          <div class="post-meta">
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>
              {dateFormatter.format(post.data.pubDate)}
            </time>
          </div>
          <div class="post-content">
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p class="post-description">{post.data.description}</p>
            <p class="post-tags">{post.data.tags.join(" · ") || "Article"}</p>
          </div>
          <a class="post-arrow" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>
            <ArrowUpRightIcon class="link-icon" aria-hidden="true" />
          </a>
        </article>
      ))}
    </section>
  ) : (
    <section class="empty-state" aria-label="No published blog posts">
      <p class="eyebrow">A note for future me</p>
      <h2>Your writing starts with a Markdown file.</h2>
      <p>Create a <code>.md</code> file in <code>src/content/blog/</code> and add frontmatter like this:</p>
      <pre><code>---
title: My new post
description: A short summary for the blog list.
pubDate: 2026-11-01
tags:
  - Engineering
---

Write your post here in Markdown.</code></pre>
      <p class="draft-tip">Posts marked <code>draft: true</code> stay hidden until you’re ready to publish.</p>
    </section>
  )}

  <section class="contact-note">
    <p class="eyebrow">Have a question or an idea?</p>
    <p>I’m always happy to talk about software, projects, and the problems behind them.</p>
    <a class="text-link" href="mailto:fahadulshadhin17@gmail.com">
      <EmailIcon class="link-icon" aria-hidden="true" />
      Write me a note
    </a>
  </section>
</SiteLayout>

<style>
  .page-intro {
    max-width: 680px;
    padding: 94px 0 65px;
  }

  h1 {
    margin: 0 0 17px;
    font-family: var(--serif);
    font-size: clamp(58px, 10vw, 92px);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  h1 span {
    color: var(--accent-muted);
  }

  .page-description {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24px;
    gap: 8px 20px;
    padding: 24px 0 27px;
    border-top: 1px solid var(--line);
  }

  .post-meta {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: baseline;
    gap: 18px;
  }

  .post-date {
    padding-top: 4px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
  }

  .post-content {
    grid-column: 1;
    grid-row: 2;
  }

  .post-tags {
    margin: 10px 0 0;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post h2 {
    margin: 0 0 7px;
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .post h2 a:hover {
    color: var(--muted);
  }

  .post-description {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .post-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--quiet);
  }

  .empty-state {
    padding: 30px;
    border: 1px solid var(--line);
    background: var(--card);
  }

  .empty-state h2 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-size: clamp(25px, 4vw, 34px);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .empty-state > p:not(.eyebrow) {
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .empty-state code {
    padding: 2px 5px;
    background: var(--paper-deep);
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .empty-state pre {
    overflow-x: auto;
    margin: 0 0 14px;
    padding: 18px;
    background: var(--code-background);
    color: var(--code-ink);
    font-size: 12px;
    line-height: 1.7;
  }

  .empty-state pre code {
    padding: 0;
    background: transparent;
  }

  .empty-state .draft-tip {
    margin: 0;
    font-size: 12px;
  }

  .contact-note {
    margin-top: 58px;
    padding: 30px;
    background: var(--paper-deep);
  }

  .contact-note > p:not(.eyebrow) {
    margin: 0 0 18px;
    color: var(--detail-copy);
    font-size: 15px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--link-underline);
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .page-intro {
      padding: 70px 0 48px;
    }

    .post {
      grid-template-columns: 1fr 18px;
      gap: 6px 12px;
    }

    .post-content {
      grid-column: 1;
      grid-row: 2;
    }

    .post-arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .post h2 {
      font-size: 22px;
    }

    .empty-state {
      padding: 24px 20px;
    }

    .empty-state pre {
      padding: 14px;
      font-size: 11px;
    }

    .contact-note {
      margin-top: 42px;
      padding: 24px 20px;
    }
  }
</style>
