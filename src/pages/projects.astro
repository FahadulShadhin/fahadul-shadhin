---
import SiteLayout from "../layouts/SiteLayout.astro";
import { agtClientWork, professionalWork, projects } from "../data/projects";
import ExternalLinkIcon from "../icons/external-link.svg";
import GitHubIcon from "../icons/github.svg";
import WebsiteIcon from "../icons/website.svg";
---

<SiteLayout title="Projects — Fahadul Islam Shadhin" description="Selected software projects by Fahadul Islam Shadhin, including developer tools, APIs, and experiments.">
  <section class="page-intro">
    <p class="eyebrow">Selected work · 2023—26</p>
    <h1>Projects<span>.</span></h1>
    <p class="page-description">A collection of tools, experiments, and ideas I’ve brought to life. A few are small utilities; all of them started with a problem worth solving.</p>
  </section>

  <section class="project-grid" aria-label="Selected projects">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-main">
          <p class="project-type">{project.type}</p>
          <h2>{project.name}</h2>
          <p class="project-description">{project.description}</p>
        </div>
        <div class="card-footer">
          <div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div>
          <div class="project-links">
            {project.live && (
              <a class="project-link live-link" href={project.live} target="_blank" rel="noreferrer" aria-label={`View ${project.name} live`} title="View live project">
                <WebsiteIcon aria-hidden="true" />
              </a>
            )}
            <a class="project-link github-link" href={project.github} target="_blank" rel="noreferrer" aria-label={`View ${project.name} on GitHub`} title="View on GitHub">
              <GitHubIcon aria-hidden="true" />
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="professional-work" aria-labelledby="professional-work-title">
    <div class="work-heading">
      <div>
        <p class="eyebrow">Commerce · Bevy Commerce</p>
        <h2 id="professional-work-title">Commerce products & client work</h2>
      </div>
      <p class="work-intro">Products and client work from my time at Bevy Commerce.</p>
    </div>
    <div class="professional-grid">
      {professionalWork.map((item) => (
        <article class="professional-card">
          <div>
            <p class="project-type">{item.organization}</p>
            <h3>{item.name}</h3>
            <p class="project-description">{item.description}</p>
          </div>
          <a class="professional-link" href={item.url} target="_blank" rel="noreferrer">
            {item.linkLabel}
            <ExternalLinkIcon class="link-icon" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="professional-work agt-work" aria-labelledby="agt-work-title">
    <div class="work-heading">
      <div>
        <p class="eyebrow">Insurance · Platform engineering · AGT Software Partners</p>
        <h2 id="agt-work-title">Insurance & platform engineering</h2>
      </div>
      <p class="work-intro">Client engagements from my work at AGT Software Partners.</p>
    </div>
    <div class="professional-grid">
      {agtClientWork.map((item) => (
        <article class="professional-card">
          <div>
            <p class="project-type">AGT Software Partners · Client</p>
            <h3>{item.name}</h3>
            <p class="project-description">{item.description}</p>
          </div>
          <a class="professional-link" href={item.url} target="_blank" rel="noreferrer">
            Visit website
            <ExternalLinkIcon class="link-icon" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .page-intro {
    max-width: 680px;
    padding: 94px 0 65px;
  }

  h1 {
    margin: 0 0 17px;
    font-family: var(--serif);
    font-size: clamp(58px, 10vw, 92px);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  h1 span {
    color: var(--accent-muted);
  }

  .page-description {
    max-width: 560px;
    margin: 0 0 25px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.8;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--link-underline);
    font-size: 14px;
    font-weight: 600;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .professional-work {
    margin-top: 76px;
  }

  .work-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }

  .work-heading .eyebrow {
    margin-bottom: 8px;
  }

  .work-heading h2 {
    margin: 0;
    font-family: var(--sans);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .work-intro {
    max-width: 330px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .professional-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .professional-card {
    min-height: 210px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border: 1px solid var(--card-border);
    border-radius: 4px;
    background: var(--card);
    box-shadow: var(--card-shadow);
  }

  .professional-card h3 {
    margin: 0 0 8px;
    font-family: var(--sans);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .professional-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    margin-top: 22px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
  }

  .project-card {
    min-height: 225px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border: 1px solid var(--card-border);
    border-radius: 4px;
    background: var(--card);
    box-shadow: var(--card-shadow);
  }

  .project-type {
    margin: 0 0 10px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project h2 {
    margin: 0 0 8px;
    font-family: var(--sans);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .project-description {
    margin: 0;
    color: var(--body-copy);
    font-size: 13px;
    line-height: 1.7;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
  }

  .tags span {
    color: var(--tag-copy);
    font-family: var(--mono);
    font-size: 9px;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 22px;
  }

  .project-links {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 12px;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: var(--muted);
    border-radius: 3px;
  }

  .project-link svg {
    display: block;
    width: 16px;
    height: 16px;
  }

  .live-link svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .github-link svg {
    fill: currentColor;
  }

  .project-link:hover {
    color: var(--ink);
  }

  .project-note {
    margin-top: 60px;
    padding: 30px;
    background: var(--paper-deep);
  }

  .project-note p:not(.eyebrow) {
    max-width: 700px;
    margin: 0 0 20px;
    color: var(--detail-copy);
    font-size: 15px;
    line-height: 1.8;
  }

  .project-note strong {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .page-intro {
      padding: 70px 0 48px;
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .professional-work {
      margin-top: 58px;
    }

    .work-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .professional-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-card {
      min-height: 215px;
      padding: 18px;
    }

    .project-note {
      margin-top: 42px;
      padding: 24px 20px;
    }
  }

  @media (max-width: 460px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .professional-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: 0;
      padding: 20px;
    }
  }
</style>
