---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import { experience, skills } from "../data/experience";
import { education } from "../data/education";
import profilePhoto from "../../assets/profile_pic_v2.jpg";
import resumePdf from "../../assets/Fahadul_Shadhin_Resume_2026.pdf?url";
---

<SiteLayout title="Fahadul Islam Shadhin — Software Engineer" description="I'm Fahadul, a software engineer building full-stack applications, backend services, and useful tools.">
  <section class="hero">
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="eyebrow"><span class="availability-dot"></span> Software engineer · Bangladesh</p>
        <h1>Hi, this is Shadhin<span>.</span></h1>
        <div class="hero-bottom">
          <p class="intro">
            I’m a software engineer who enjoys turning complex workflows into clear, dependable software. I work across the stack—from thoughtful interfaces to APIs and integrations that keep things moving.
          </p>
        </div>
        <nav class="intro-links" aria-label="Contact and social links">
          <a href="mailto:fahadulshadhin17@gmail.com">Email</a>
          <a href="https://github.com/FahadulShadhin" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://linkedin.com/in/fahadul-shadhin" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a class="resume-button" href={resumePdf} download="Fahadul_Shadhin_Resume_2026.pdf" aria-label="Download resume PDF">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 2.5v7m0 0 2.75-2.75M8 9.5 5.25 6.75M3 11v2h10v-2"></path>
            </svg>
            Resume PDF
          </a>
        </nav>
      </div>
      <figure class="profile-frame">
        <Image
          class="profile-photo"
          src={profilePhoto}
          alt="Fahadul Islam Shadhin"
          width={520}
          height={670}
          format="webp"
          quality={85}
          inferSize
        />
        <!-- <figcaption>Fahadul Islam Shadhin</figcaption> -->
      </figure>
    </div>
  </section>

  <section class="work-section">
    <div class="section-heading">
      <div>
        <h2>Experience</h2>
      </div>
      <!-- <span class="section-index">02 / 03</span> -->
    </div>
    <div class="experience-list">
      {experience.map((employer) => (
        <article class="experience-company">
          <h3 class="company">
            {employer.url ? <a href={employer.url} target="_blank" rel="noreferrer">{employer.company} <span aria-hidden="true">↗</span></a> : employer.company}
          </h3>
          {(employer.employmentType || employer.location) && (
            <p class="company-meta">
              {[employer.employmentType, employer.location].filter(Boolean).join(" · ")}
            </p>
          )}
          <p class="experience-detail company-detail">{employer.detail}</p>
          <div class="position-list">
            {employer.positions.map((position) => (
              <article class="position-item">
                <div class="position-timeline" aria-hidden="true"><span></span></div>
                <div class="position-content">
                  <h4>{position.role}</h4>
                  <p class="position-date">{position.dates}</p>
                </div>
              </article>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="skills-section">
    <div class="section-heading">
      <div>
        <h2>What I work with</h2>
      </div>
      <span class="section-index">03 / 03</span>
    </div>
    <div class="skill-list">
      {skills.map((skill) => <span>{skill}</span>)}
    </div>
  </section>

  <section class="education-section">
    <div class="section-heading">
      <div>
        <!-- <p class="eyebrow">Education</p> -->
        <h2>Education</h2>
      </div>
    </div>
    <div class="education-list">
      {education.map((item) => (
        <article class="education-item">
          <div>
            <h3>{item.institution}</h3>
            <p class="education-degree">{item.degree}</p>
            <p class="education-location">{item.location}</p>
          </div>
          <p class="education-dates">{item.dates}</p>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .hero,
  .work-section,
  .skills-section,
  .education-section {
    --section-space: 40px;
  }

  .hero {
    padding: var(--section-space) 0;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    align-items: center;
    gap: clamp(36px, 7vw, 88px);
  }

  .hero-copy {
    min-width: 0;
  }

  .profile-frame {
    position: relative;
    width: 100%;
    height: 320px;
    margin: 0;
    padding: 8px;
    border: 1px solid var(--profile-frame);
    background: var(--card);
  }

  .profile-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 36%;
  }

  .profile-caption {
    position: absolute;
    right: 8px;
    bottom: 8px;
    left: 8px;
    padding: 8px 10px;
    background: var(--profile-caption);
    color: var(--body-copy);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .availability-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 8px 1px 0;
    border-radius: 50%;
    background: var(--availability);
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 38px;
    font-family: var(--serif);
    font-size: clamp(48px, 8.5vw, 88px);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 1.06;
  }

  h1 span {
    color: var(--accent-muted);
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 36px;
  }

  .intro {
    max-width: 570px;
    margin: 0;
    color: var(--body-copy);
    font-size: 17px;
    line-height: 1.8;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 24px;
  }

  .intro-links a {
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
  }

  .intro-links .resume-button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    transition: color 160ms ease;
  }

  .intro-links .resume-button:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .resume-button svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .text-link {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 10px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--link-underline);
    font-size: 14px;
    font-weight: 600;
  }

  .text-link span,
  .cta-links a span {
    transition: transform 160ms ease;
  }

  .text-link:hover span,
  .cta-links a:hover span {
    transform: translate(2px, -2px);
  }

  .hero-meta {
    display: flex;
    gap: 30px;
    margin-top: 52px;
    padding-top: 17px;
    border-top: 1px solid var(--line);
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .intro-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    padding: 70px 0 82px;
    border-top: 1px solid var(--line);
  }

  .section-label {
    color: var(--muted);
    font-size: 13px;
  }

  .section-label span,
  .section-index {
    margin-right: 10px;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
  }

  .section-copy {
    max-width: 590px;
  }

  .section-copy h2,
  .section-heading h2,
  .writing-cta h2 {
    margin-bottom: 18px;
    font-family: var(--serif);
    font-size: clamp(29px, 4vw, 40px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .section-copy p,
  .writing-cta > div > p:last-child {
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.85;
  }

  .section-copy .text-link {
    margin-top: 8px;
  }

  .work-section,
  .skills-section,
  .education-section {
    padding: var(--section-space) 0;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--section-space);
  }

  .section-heading .eyebrow {
    margin-bottom: 8px;
  }

  .section-heading h2 {
    margin: 0;
  }

  .section-index {
    margin: 0 0 7px;
  }

  .experience-company {
    padding: 24px 0 26px;
    border-top: 1px solid var(--line);
  }

  .company {
    margin: 0 0 3px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .company-meta {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .company-detail {
    max-width: 580px;
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .position-item {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    padding-bottom: 22px;
  }

  .position-item:last-child {
    padding-bottom: 0;
  }

  .position-timeline {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .position-timeline span {
    z-index: 1;
    width: 10px;
    height: 10px;
    margin-top: 6px;
    border-radius: 50%;
    background: var(--timeline-dot);
  }

  .position-timeline::after {
    position: absolute;
    top: 20px;
    bottom: -2px;
    width: 2px;
    background: var(--timeline-line);
    content: "";
  }

  .position-item:last-child .position-timeline::after {
    display: none;
  }

  .position-content h4 {
    margin: 0 0 3px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .position-date {
    margin: 0;
    color: var(--quiet);
    font-size: 13px;
    line-height: 1.6;
  }

  .company a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }

  .skill-list span {
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--body-copy);
    font-family: var(--mono);
    font-size: 11px;
  }

  .education-item {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }

  .education-item h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .education-degree,
  .education-location,
  .education-dates {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  .education-dates {
    flex-shrink: 0;
    color: var(--quiet);
  }

  .writing-cta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 35px;
    margin-top: 5px;
    padding: 38px;
    background: var(--paper-deep);
  }

  .writing-cta .eyebrow {
    margin-bottom: 12px;
  }

  .writing-cta h2 {
    margin-bottom: 10px;
    font-size: clamp(25px, 3.5vw, 34px);
  }

  .writing-cta > div > p:last-child {
    margin: 0;
    font-size: 14px;
  }

  .cta-links {
    display: grid;
    flex-shrink: 0;
    gap: 12px;
    min-width: 145px;
  }

  .cta-links a {
    display: flex;
    justify-content: space-between;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--blockquote-line);
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .hero,
    .work-section,
    .skills-section,
    .education-section {
      --section-space: 32px;
    }

    .hero-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .profile-frame {
      width: min(100%, 260px);
      height: 320px;
      justify-self: center;
    }

    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }

    .intro {
      font-size: 15px;
    }

    .hero-meta {
      flex-direction: column;
      gap: 8px;
      margin-top: 38px;
    }

    .position-item {
      gap: 8px;
    }

    .education-item {
      flex-direction: column;
      gap: 8px;
    }

    .writing-cta {
      align-items: flex-start;
      flex-direction: column;
      padding: 26px 22px;
    }
  }
</style>
