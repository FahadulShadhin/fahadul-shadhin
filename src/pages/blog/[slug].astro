---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<SiteLayout title={`${post.data.title} — Fahadul Islam Shadhin`} description={post.data.description}>
  <article class="article">
    <a class="back-link" href="/blog/">
      <svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M14 8H2m0 0 5-5m-5 5 5 5" /></svg>
      All posts
    </a>
    <header class="article-header">
      <p class="eyebrow">
        <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {post.data.tags.length > 0 && <p class="article-tags">{post.data.tags.join(" · ")}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</SiteLayout>

<script is:inline>
  const copyIcon = `
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <rect x="5.25" y="5.25" width="7.5" height="7.5" rx="1"></rect>
      <path d="M10.75 5.25V4A1.75 1.75 0 0 0 9 2.25H4A1.75 1.75 0 0 0 2.25 4v5A1.75 1.75 0 0 0 4 10.75h1.25"></path>
    </svg>
  `;

  const checkIcon = `
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="m3 8.25 3.25 3.25L13 5"></path>
    </svg>
  `;

  async function copyCode(button) {
    const codeBlock = button.closest(".code-block");
    const code = codeBlock?.querySelector("pre")?.textContent ?? "";

    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(code);
      } else {
        const textarea = document.createElement("textarea");
        textarea.value = code;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();

        try {
          if (!document.execCommand("copy")) {
            throw new Error("Clipboard copy failed");
          }
        } finally {
          textarea.remove();
        }
      }

      button.classList.add("copied");
      button.innerHTML = checkIcon;
      button.setAttribute("aria-label", "Code copied");

      window.setTimeout(() => {
        button.classList.remove("copied");
        button.innerHTML = copyIcon;
        button.setAttribute("aria-label", "Copy code");
      }, 2000);
    } catch (error) {
      console.error("Unable to copy code.", error);
      button.innerHTML = copyIcon;
      button.setAttribute("aria-label", "Unable to copy code");
    }
  }

  document.querySelectorAll(".prose pre").forEach((pre) => {
    if (pre.closest(".code-block")) return;

    const wrapper = document.createElement("div");
    wrapper.className = "code-block";

    const button = document.createElement("button");
    button.className = "copy-code-button";
    button.type = "button";
    button.setAttribute("aria-label", "Copy code");
    button.innerHTML = copyIcon;

    pre.before(wrapper);
    wrapper.append(button, pre);
  });

  document.querySelectorAll(".copy-code-button").forEach((button) => {
    button.addEventListener("click", () => copyCode(button));
  });
</script>

<style>
  .article {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 62px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: 13px;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .article-header {
    padding: 46px 0 38px;
    border-bottom: 1px solid var(--line);
  }

  .article-header .eyebrow {
    margin-bottom: 15px;
  }

  .article-header h1 {
    margin: 0 0 15px;
    font-family: var(--serif);
    font-size: clamp(38px, 6vw, 52px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .article-description {
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .article-tags {
    margin: 12px 0 0;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .prose {
    padding: 34px 0 10px;
    color: var(--body-copy);
    font-size: 16px;
    line-height: 1.9;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 1.8em 0 0.6em;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .prose :global(h2) {
    font-size: 32px;
  }

  .prose :global(h3) {
    font-size: 24px;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-underline-offset: 3px;
  }

  .prose :global(a[href^="http"]::after) {
    content: " ↗";
    font-size: 0.8em;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding-left: 20px;
    border-left: 2px solid var(--blockquote-line);
    color: var(--muted);
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 18px;
    background: var(--paper-deep);
    font-size: 13px;
    line-height: 1.7;
  }

  .prose :global(.code-block) {
    position: relative;
    margin: 1.6em 0;
  }

  .prose :global(.code-block > pre) {
    margin: 0;
    padding-right: 52px;
  }

  .prose :global(.copy-code-button) {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    display: grid;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    opacity: 0.82;
    transition: color 160ms ease, opacity 160ms ease;
  }

  .prose :global(.copy-code-button:hover),
  .prose :global(.copy-code-button:focus-visible) {
    color: var(--ink);
    opacity: 1;
  }

  .prose :global(.copy-code-button:focus-visible) {
    outline: 2px solid var(--muted);
    outline-offset: 2px;
    border-radius: 3px;
  }

  .prose :global(.copy-code-button svg) {
    width: 16px;
    height: 16px;
    justify-self: center;
    align-self: center;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .prose :global(.copy-code-button.copied) {
    color: var(--availability);
  }

  .prose :global(pre.astro-code) {
    background-color: var(--shiki-light-bg);
    color: var(--shiki-light);
  }

  .prose :global(pre.astro-code span) {
    color: var(--shiki-light);
  }

  :global(html[data-theme="dark"]) .prose :global(pre.astro-code) {
    background-color: var(--shiki-dark-bg);
    color: var(--shiki-dark);
  }

  :global(html[data-theme="dark"]) .prose :global(pre.astro-code span) {
    color: var(--shiki-dark);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 5px;
    background: var(--paper-deep);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .article {
      padding-top: 40px;
    }

    .article-header {
      padding: 34px 0 28px;
    }

    .article-description {
      font-size: 15px;
    }

    .prose {
      font-size: 15px;
    }
  }
</style>
