---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<SiteLayout title={`${post.data.title} — Fahadul Islam Shadhin`} description={post.data.description}>
  <article class="article">
    <a class="back-link" href="/blog">← All posts</a>
    <header class="article-header">
      <p class="eyebrow">
        <time datetime={post.data.pubDate.toISOString()}>{dateFormatter.format(post.data.pubDate)}</time>
        {post.data.tags.length > 0 && <span> · {post.data.tags.join(" · ")}</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</SiteLayout>

<style>
  .article {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 62px;
  }

  .back-link {
    color: var(--muted);
    font-size: 13px;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .article-header {
    padding: 46px 0 38px;
    border-bottom: 1px solid var(--line);
  }

  .article-header .eyebrow {
    margin-bottom: 15px;
  }

  .article-header h1 {
    margin: 0 0 15px;
    font-family: var(--serif);
    font-size: clamp(42px, 8vw, 68px);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .article-description {
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .prose {
    padding: 34px 0 10px;
    color: var(--body-copy);
    font-size: 16px;
    line-height: 1.9;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: 1.8em 0 0.6em;
    color: var(--ink);
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .prose :global(h2) {
    font-size: 32px;
  }

  .prose :global(h3) {
    font-size: 24px;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
    text-underline-offset: 3px;
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding-left: 20px;
    border-left: 2px solid var(--blockquote-line);
    color: var(--muted);
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 18px;
    background: var(--paper-deep);
    font-size: 13px;
    line-height: 1.7;
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 5px;
    background: var(--paper-deep);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .article {
      padding-top: 40px;
    }

    .article-header {
      padding: 34px 0 28px;
    }

    .article-description {
      font-size: 15px;
    }

    .prose {
      font-size: 15px;
    }
  }
</style>
